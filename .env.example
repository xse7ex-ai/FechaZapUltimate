# ==============================================================================
# FechaZap - Variáveis de Ambiente e Segredos (Frontend Netlify + Supabase Edge Functions)
# ==============================================================================

# 1. Variáveis Públicas do Frontend (Netlify / Vite)
# Seguras para exposição pública no navegador (iniciam com VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# 2. Segredos do Servidor (Supabase Secrets para Edge Functions)
# Injetados no Supabase CLI: supabase secrets set GEMINI_API_KEY=...
# NUNCA expor no frontend!
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Meta WhatsApp Cloud API (Segredos Únicos do Servidor para o Plano TURBO)
# Injetados no Supabase CLI: supabase secrets set WHATSAPP_TOKEN=... PHONE_NUMBER_ID=...
# Conta única da plataforma com fallback universal garantido para wa.me
WHATSAPP_TOKEN="EAAxxxxxxxYourMetaWhatsAppBearerToken"
PHONE_NUMBER_ID="123456789012345"
WHATSAPP_TEMPLATE_NAME="fechazap_followup"
