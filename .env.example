# ==============================================================================
# FechaZap - Variáveis de Ambiente e Segredos (Frontend Netlify + Supabase Edge Functions)
# ==============================================================================

# 1. Variáveis Públicas do Frontend (Netlify / Vite)
# Seguras para exposição pública no navegador (iniciam com VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# 2. Segredos e Configurações do Servidor (Supabase Secrets para Edge Functions)
# Injetados no Supabase CLI: supabase secrets set FRONTEND_ORIGIN=... GEMINI_API_KEY=...
# NUNCA expor no frontend!
FRONTEND_ORIGIN="https://fechazap.netlify.app"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 3. Meta WhatsApp Cloud API (Segredos do Servidor)
# Injetados no Supabase CLI: supabase secrets set WHATSAPP_APP_SECRET=... WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_TOKEN="EAAxxxxxxxYourMetaWhatsAppBearerToken"
WHATSAPP_APP_SECRET="your_meta_app_secret_here"
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token_here"
PHONE_NUMBER_ID="123456789012345"
WHATSAPP_TEMPLATE_NAME="fechazap_followup"
