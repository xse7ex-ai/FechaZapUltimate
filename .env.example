# ==============================================================================
# FechaZap 3.1.5 - Variáveis de Ambiente e Segredos (Produção Cloudflare + Supabase)
# ==============================================================================

# 1. Google Gemini API (OBRIGATÓRIO PARA IA)
# Protegido no servidor/Cloudflare Worker - NUNCA expor no frontend!
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. Supabase Backend (Autenticação, RLS, Planos e Quotas de IA)
# Usado no Cloudflare Worker ou Node backend para validar JWTs e aplicar limites atômicos
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 3. Supabase Frontend Client (Chave pública anônima)
# Seguro para exposição pública no navegador
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# 4. URL da API do Backend (Frontend Cloudflare Pages -> Worker)
# Em produção separada: https://fechazap-backend.your-subdomain.workers.dev
# Se Pages Functions ou mesmo domínio: deixar vazio
VITE_API_URL=""

# 5. Domínios permitidos pelo CORS no Worker (separados por vírgula)
ALLOWED_ORIGINS="https://fechazap.pages.dev,http://localhost:3000,http://localhost:5173"

# 6. Meta WhatsApp Cloud API (Opcional - Para envio automatizado oficial)
# Tokens oficiais da Meta Graph API mantidos 100% no servidor/Worker
WHATSAPP_TOKEN="EAAxxxxxxxYourMetaWhatsAppBearerToken"
PHONE_NUMBER_ID="123456789012345"

# 7. Configuração do Servidor Local
APP_URL="https://fechazap.pages.dev"
PORT=3000
